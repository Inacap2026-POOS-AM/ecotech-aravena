# Copia este archivo como .env y ajusta los valores. El .env real NO se sube a Git.

# Usuario inicial (se crea una sola vez con contraseña hasheada con bcrypt)
ADMIN_USER=admin
ADMIN_PASSWORD=CambiaEstaClave123

# Configuración de red
API_TIMEOUT=5
API_MAX_INTENTOS=3

# Ruta de la base de datos local (opcional)
# DB_PATH=ecotech.db

# Endpoints (opcional; sirven para la prueba de "URL inválida" en vivo)
# GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# PRONOSTICO_URL=https://api.open-meteo.com/v1/forecast
# CAMBIO_URL=https://open.er-api.com/v6/latest/USD
